# Copy to .env.local (development) or set in your hosting provider.

# Backend URL. If not set, the app uses port 8080 on the same host it was opened from.
REACT_APP_API_URL=http://localhost:8080

# On Vercel/Netlify set this to "/" so assets are served from the root
# (package.json "homepage" is only for GitHub Pages).
# PUBLIC_URL=/

# Copy this file to .env and fill in the values.

PORT=8080
MONGO_CONN=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<db>
# Use a long random string in production (e.g. `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"`)
JWT_SECRET=change-me

# Frontend URL, used in password-reset emails
CLIENT_URL=http://localhost:3000
# Comma-separated list of allowed frontend origins (leave empty to allow all in development)
CORS_ORIGINS=

# Razorpay (Dashboard -> Account & Settings -> API Keys). Use rzp_test_... keys while developing.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Razorpay Dashboard -> Webhooks: URL https://<backend>/payment/webhook,
# events payment.captured + payment.failed, and the same secret here.
RAZORPAY_WEBHOOK_SECRET=

# Email (optional). Without these, emails are printed in the server console.
# Gmail example: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_USER=you@gmail.com, SMTP_PASS=<16-char app password>
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Shopper <you@gmail.com>"

# Optional: max login/signup attempts per IP per 15 minutes (default 30)
AUTH_RATE_LIMIT=30
